<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Le contrôle gestuel doit survivre à la sortie de l'application : c'est tout l'objet d'un
      service de premier plan de type caméra. Android impose en contrepartie une notification
      permanente, que l'utilisateur peut utiliser pour arrêter le service.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Dessin du curseur au-dessus des autres applications. Accordée par l'utilisateur dans
         les réglages, jamais par une simple invite. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Visibilité des applications installées. Une déclaration <queries> ciblée remplace la
      permission QUERY_ALL_PACKAGES, à usage restreint.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <!--
                Application ordinaire, et non écran d'accueil de remplacement.
                Les catégories HOME et DEFAULT faisaient de l'application un candidat au rôle de
                launcher : Android proposait de le choisir à chaque appui sur le bouton d'accueil,
                et l'action « Accueil » du contrôle gestuel pouvait y revenir au
                lieu de l'écran d'accueil de l'utilisateur. C'est un contrôleur, pas un
                lanceur ; il ne garde donc que LAUNCHER, qui le fait figurer dans la liste des
                applications.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StarkVisionService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <service
            android:name=".service.StarkAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
